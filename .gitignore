# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ─── 노트 데이터 ─────────────────────────────────────────────────
# v9부터 노트는 ComfyUI/user/bmk_notes/ 에 저장되므로 이 폴더는 원래 없다.
# 아래는 이중 방어 — 자동 마이그레이션이 실패한 설치본에는 구 폴더가
# 그대로 남을 수 있고, 그게 커밋되면 노트 원문이 그대로 공개된다.
notes/

# ─── 로컬 동기화/백업 도구 산출물 ────────────────────────────────
# FreeFileSync 등이 남기는 DB. 로컬 절대경로가 들어 있다.
*.ffs_db
*.ffs_lock
sync.ffs_db

# ─── 로컬 전용 설정 ──────────────────────────────────────────────
.env
*.local.json

# ─── 편집기 / OS ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
