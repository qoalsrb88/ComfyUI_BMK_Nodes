    "request_rules": {
      "_comment": "보내는 키는 위 목록이 전부다(2.6 이 아닌 모델은 complexity 를 뺀다). 아래 키는 보내지 않는다.",
      "never": [
        "mask_image",
        "template_id",
        "positive_prompt_prefix",
        "positive_prompt_suffix",
        "trigger_words",
        "width",
        "height",
        "seed",
        "aspect_ratio",
        "input_image_references"
      ],
      "request_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "request_id_max": 128,
      "max_inputs_per_group": 16,
      "num_outputs": [
        1,
        16
      ]
    },
    "checkpoints": {
      "gpt-image-2.5-sunburst": "gpt_image_25_sunburst",
      "gpt-image-2.5-flare": "gpt_image_25_flare",
      "gpt-image-2.6-sunburst": "gpt_image_26_sunburst",
      "gpt-image-2.6-flare": "gpt_image_26_flare"
    },
    "response": {
      "job_id": "5b2f6c1e-8a7d-5c3b-9e21-4f0a6d7c8b90",
      "job_ids": [
        "5b2f6c1e-8a7d-5c3b-9e21-4f0a6d7c8b90"
      ],
      "status": "pending"
    },
    "idempotency": "request_id 가 같으면(같은 사용자) 상태와 무관하게 — 완료·실패한 잡이어도 — 기존 잡의 job_id 와 지금 status 를 그대로 돌려준다. 새로 생성하려면 request_id 가 달라야 한다."
