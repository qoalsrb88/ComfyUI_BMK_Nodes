  "generate": {
    "method": "POST",
    "path": "/api/image/generate",
    "request": {
      "checkpoint": "gpt_image_26_sunburst",
      "prompt": "프롬프트 원문 그대로",
      "quality": "high",
      "size": "1024x1536",
      "background": "opaque",
      "num_outputs": 2,
      "complexity": "high",
      "moderation": "low",
      "input_images": [
        [
          "data:image/png;base64,iVBORw0KGgo=",
          "data:image/png;base64,iVBORw0KGgo="
        ]
      ],
      "organization_id": "org1",
      "request_id": "dp-0a1b2c3d4e5f-0123456789abcdef01234567_r1-a1",
      "prompt_autopilot": false
